@import "tailwindcss";

@layer base {
  :root {
    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-urdu: 'Noto Nastaliq Urdu', 'Amiri', serif;
    --font-hindi: 'Noto Serif Devanagari', 'Mangal', Georgia, serif;
    --font-devanagari: var(--font-hindi);

    /* Distinctive Literary Colour Identity */
    --color-deep-ink: #20231F;
    --color-warm-paper: #F2EBDD;
    --color-warm-paper-light: #FBF8F3;
    --color-muted-olive: #777C60;
    --color-muted-olive-dark: #4A4E39;
    --color-muted-olive-light: #E8ECE0;
    --color-terracotta: #A65F46;
    --color-terracotta-light: #F7EBE7;
    --color-antique-gold: #B89A65;
    --color-stone: #C8C0B2;
    --color-stone-light: #E5DFD4;
    --color-soft-glass: rgba(255, 255, 255, 0.42);
    --color-ink-glass: rgba(32, 35, 31, 0.82);

    /* Legacy mapping for backward compatibility */
    --color-paper-light: var(--color-warm-paper);
    --color-paper-warm: #EAE2D2;
    --color-paper-border: var(--color-stone);
    --color-charcoal: var(--color-deep-ink);
    --color-charcoal-muted: #595550;
    --color-olive: var(--color-muted-olive);
    --color-olive-dark: var(--color-muted-olive-dark);
    --color-olive-light: var(--color-muted-olive-light);
    --color-clay: var(--color-terracotta);
    --color-clay-light: var(--color-terracotta-light);
    --color-gold: var(--color-antique-gold);
  }

  body {
    background-color: var(--color-warm-paper);
    color: var(--color-deep-ink);
    font-family: var(--font-sans);
    line-height: 1.65;
    scroll-behavior: smooth;
    overflow-x: clip;
  }

  img {
    max-width: 100%;
  }

  h1, h2, h3, h4, .font-editorial {
    font-family: var(--font-serif);
    letter-spacing: -0.015em;
  }

  /* Urdu Typography: Noto Nastaliq Urdu with RTL shaping & line-height */
  .font-urdu, [lang="ur"], [dir="rtl"] {
    font-family: var(--font-urdu);
    direction: rtl;
    text-align: right;
    line-height: 2.1;
    letter-spacing: normal !important;
    font-feature-settings: "calt" 1, "liga" 1, "kern" 1;
  }

  /* Hindi & Marathi Typography: Jodakshar & Noto Serif Devanagari with conjunct support */
  .font-hindi, [lang="hi"], [lang="mr"] {
    font-family: var(--font-hindi);
    direction: ltr;
    line-height: 1.75;
    letter-spacing: 0.005em;
  }
}

/* Custom Paper Texture Overlay */
.paper-grain {
  background-image: radial-gradient(rgba(28, 27, 26, 0.04) 1px, transparent 0);
  background-size: 24px 24px;
}

/* The same texture uses light ink on the cinematic shell so it stays visible
   against near-black surfaces. Admin/recovery keep the original paper grain. */
.cinematic-shell .paper-grain {
  background-image: radial-gradient(rgba(244, 239, 229, 0.085) 1px, transparent 0);
  background-size: 24px 24px;
}

.paper-card {
  background-color: #FFFFFF;
  border: 1px solid var(--color-paper-border);
  box-shadow: 0 4px 20px -2px rgba(28, 27, 26, 0.03), 0 2px 6px -1px rgba(28, 27, 26, 0.02);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.paper-card:hover {
  transform: translateY(-2px);
  border-color: #D3CAB8;
  box-shadow: 0 12px 28px -4px rgba(28, 27, 26, 0.06), 0 4px 12px -2px rgba(28, 27, 26, 0.04);
}

/* Subtle line link animation */
.editorial-link {
  position: relative;
  display: inline-block;
  text-decoration: none;
}

.editorial-link::after {
  content: '';
  position: absolute;
  width: 100%;
  transform: scaleX(0);
  height: 1px;
  bottom: -2px;
  left: 0;
  background-color: currentColor;
  transform-origin: bottom right;
  transition: transform 0.25s ease-out;
}

.editorial-link:hover::after {
  transform: scaleX(1);
  transform-origin: bottom left;
}

/* Custom scrollbar for literary feel */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: #FAF8F5;
}

::-webkit-scrollbar-thumb {
  background: #D8D2C5;
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: #455240;
}

/* Cinematic public pages use a dark scrollbar. `:has()` targets the viewport
   scrollbar only when a public shell is mounted; admin keeps the light one. */
html:has(.cinematic-shell)::-webkit-scrollbar-track,
.cinematic-shell ::-webkit-scrollbar-track {
  background: #0A0B09;
}

html:has(.cinematic-shell)::-webkit-scrollbar-thumb,
.cinematic-shell ::-webkit-scrollbar-thumb {
  background: #464535;
  border: 1px solid #0A0B09;
  border-radius: 3px;
}

html:has(.cinematic-shell)::-webkit-scrollbar-thumb:hover,
.cinematic-shell ::-webkit-scrollbar-thumb:hover {
  background: var(--cine-gold);
}

/* ==========================================================================
   GLASSMORPHISM DESIGN SYSTEM (Primary Visual Identity)
   ========================================================================== */

:root {
  --glass-bg-primary: rgba(255, 255, 255, 0.72);
  --glass-bg-secondary: rgba(250, 248, 245, 0.65);
  --glass-bg-elevated: rgba(255, 255, 255, 0.85);
  --glass-bg-dark: rgba(24, 23, 22, 0.84);
  --glass-border: rgba(255, 255, 255, 0.7);
  --glass-border-subtle: rgba(232, 226, 213, 0.55);
  --glass-border-dark: rgba(255, 255, 255, 0.14);
  --glass-shadow: 0 8px 32px 0 rgba(28, 27, 26, 0.06), 0 2px 8px 0 rgba(28, 27, 26, 0.03);
  --glass-shadow-lg: 0 20px 48px -8px rgba(28, 27, 26, 0.12), 0 4px 16px -2px rgba(28, 27, 26, 0.05);
}

/* Translucent Glass Surface Panel */
.glass-panel {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 8px 32px 0 rgba(28, 27, 26, 0.06), 0 1px 3px 0 rgba(28, 27, 26, 0.04);
}

/* Glass Card with Smooth Hover Elevation */
.glass-card {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(16px) saturate(160%);
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  border: 1px solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4px 20px -2px rgba(28, 27, 26, 0.04), 0 2px 6px -1px rgba(28, 27, 26, 0.02);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.glass-card:hover {
  transform: translateY(-3px);
  background: rgba(255, 255, 255, 0.88);
  border-color: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16px 36px -4px rgba(28, 27, 26, 0.09), 0 4px 12px -2px rgba(28, 27, 26, 0.04);
}

/* Glass Navigation Bar */
.glass-nav {
  background: rgba(250, 248, 245, 0.82);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4px 24px 0 rgba(28, 27, 26, 0.04);
}

/* Glass Pill / Badge */
.glass-pill {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 2px 8px rgba(28, 27, 26, 0.04);
}

/* Dark Glass Container (Reel Player / Cinematic / Footer) */
.glass-dark {
  background: rgba(24, 23, 22, 0.84);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 20px 48px -8px rgba(0, 0, 0, 0.3);
  color: #FAF8F5;
}

/* Dark Glass Control Elements */
.glass-dark-control {
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  transition: all 0.2s ease;
}

.glass-dark-control:hover {
  background: rgba(0, 0, 0, 0.7);
  border-color: rgba(255, 255, 255, 0.35);
  transform: scale(1.04);
}

/* Glass Action Buttons */
.glass-button {
  background: rgba(28, 27, 26, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #FAF8F5;
  box-shadow: 0 4px 14px rgba(28, 27, 26, 0.14);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.glass-button:hover {
  background: rgba(46, 55, 43, 0.95);
  border-color: rgba(255, 255, 255, 0.25);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(46, 55, 43, 0.22);
}

.glass-button-secondary {
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.75);
  color: var(--color-charcoal);
  box-shadow: 0 2px 8px rgba(28, 27, 26, 0.04);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.glass-button-secondary:hover {
  background: rgba(255, 255, 255, 0.92);
  border-color: rgba(255, 255, 255, 0.95);
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(28, 27, 26, 0.08);
}

/* Glass Inputs & Form Controls */
.glass-input {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(232, 226, 213, 0.8);
  box-shadow: inset 0 1px 2px rgba(28, 27, 26, 0.03);
  transition: all 0.2s ease;
}

.glass-input:focus {
  background: rgba(255, 255, 255, 0.94);
  border-color: var(--color-olive);
  box-shadow: 0 0 0 3px rgba(69, 82, 64, 0.15);
  outline: none;
}

/* Glass Modal Overlay and Body */
.glass-modal {
  background: rgba(250, 248, 245, 0.92);
  backdrop-filter: blur(28px) saturate(190%);
  -webkit-backdrop-filter: blur(28px) saturate(190%);
  border: 1px solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 24px 64px -12px rgba(28, 27, 26, 0.18), 0 4px 20px rgba(28, 27, 26, 0.08);
}


/* ==========================================================================
   EDITORIAL TYPOGRAPHY SYSTEM
   ========================================================================== */

/* Oversized display heading — for hero titles */
.editorial-display {
  font-family: var(--font-serif);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 0.9;
}

/* Tiny uppercase label — section identifiers, category chips */
.editorial-label {
  font-family: var(--font-sans);
  font-size: 0.625rem;
  font-weight: 700;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  line-height: 1.4;
}

/* Decorative oversized section number */
.editorial-number {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: clamp(5rem, 12vw, 10rem);
  line-height: 1;
  letter-spacing: -0.04em;
  color: rgba(32, 35, 31, 0.07);
  user-select: none;
  pointer-events: none;
}

/* Fine horizontal rule — olive accent */
.section-rule {
  display: block;
  width: 3rem;
  height: 1.5px;
  background-color: var(--color-muted-olive);
}

/* Italic serif lead — opening paragraph of a section */
.editorial-lead {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(1.1rem, 2.5vw, 1.4rem);
  line-height: 1.6;
  color: #595550;
}

/* Gallery image scale on hover — avoids Tailwind utility conflict */
.group-hover\:scale-108:hover {
  transform: scale(1.08);
}

/* Smooth image reveal transition */
.img-reveal {
  transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
}

@media (prefers-reduced-motion: reduce) {
  html,
  body {
    scroll-behavior: auto;
  }
}

/* Full-bleed dark section */
.section-ink {
  background-color: var(--color-deep-ink);
  color: var(--color-warm-paper);
}

/* ==========================================================================
   RESPONSIVE UTILITIES
   ========================================================================== */

/* Clamp-based fluid typography for responsive scaling */
.text-fluid-hero {
  font-size: clamp(3.2rem, 10vw, 9rem);
}

.text-fluid-display {
  font-size: clamp(2rem, 5vw, 4rem);
}

.text-fluid-title {
  font-size: clamp(1.6rem, 3.5vw, 3rem);
}

/* Minimal line separator */
.rule-gold {
  display: block;
  width: 1px;
  background: linear-gradient(to bottom, transparent, #B89A65, transparent);
}

/* Masonry auto-rows for the gallery grid */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  grid-auto-rows: 180px;
  gap: 0.75rem;
}

/* ==========================================================================
   CINEMATIC EDITORIAL FOUNDATION
   Presentation-only tokens. Existing glass/paper utilities are untouched.
   ========================================================================== */

.cinematic-shell {
  position: relative;
  isolation: isolate;
  color: var(--cine-ivory);
  background-color: var(--cine-ink);
  background-image:
    radial-gradient(ellipse 70% 45% at 14% -8%, rgba(201, 167, 97, 0.12), transparent 60%),
    radial-gradient(ellipse 60% 42% at 92% 6%, rgba(164, 103, 81, 0.09), transparent 62%),
    linear-gradient(180deg, #0A0B09 0%, #10110E 55%, #080907 100%);
  background-attachment: fixed;
  --cine-ink: #0A0B09;
  --cine-ink-raised: #141511;
  --cine-ivory: #F4EFE5;
  --cine-ivory-soft: #CFC8BA;
  --cine-ivory-muted: #9C9587;
  --cine-gold: #C9A761;
  --cine-gold-bright: #E0C483;
  --cine-gold-dim: rgba(201, 167, 97, 0.16);
  --cine-gold-line: rgba(201, 167, 97, 0.28);
  --cine-terracotta: #A46751;
  --cine-panel: rgba(255, 255, 255, 0.035);
  --cine-panel-strong: rgba(18, 19, 16, 0.88);
  --cine-shadow: 0 28px 80px -28px rgba(0, 0, 0, 0.8);
}

.cinematic-shell ::selection {
  background: rgba(201, 167, 97, 0.28);
  color: var(--cine-ivory);
}

.cinematic-shell a:focus-visible,
.cinematic-shell button:focus-visible,
.cinematic-shell input:focus-visible,
.cinematic-shell select:focus-visible,
.cinematic-shell textarea:focus-visible {
  outline: 2px solid var(--cine-gold-bright);
  outline-offset: 3px;
}

/* Ambient layers live behind content but inside the shell stacking context. */
.cine-atmosphere {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.cine-atmosphere__grain {
  position: absolute;
  inset: 0;
  opacity: 0.38;
  background-image: radial-gradient(rgba(244, 239, 229, 0.055) 0.65px, transparent 0.65px);
  background-size: 5px 5px;
  mix-blend-mode: screen;
}

.cine-atmosphere__vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 35%, transparent 30%, rgba(0, 0, 0, 0.42) 100%);
}

.cine-atmosphere__glow {
  position: absolute;
  border-radius: 9999px;
  filter: blur(110px);
}

.cine-atmosphere__glow--gold {
  top: -12rem;
  left: -10rem;
  width: 34rem;
  height: 34rem;
  background: rgba(201, 167, 97, 0.11);
}

.cine-atmosphere__glow--clay {
  top: 28%;
  right: -14rem;
  width: 38rem;
  height: 38rem;
  background: rgba(164, 103, 81, 0.09);
  filter: blur(130px);
}

.cine-atmosphere__glow--olive {
  bottom: 12%;
  left: -12rem;
  width: 30rem;
  height: 30rem;
  background: rgba(111, 126, 91, 0.08);
  filter: blur(140px);
}

/* Editorial surfaces */
.cine-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018));
  border: 1px solid var(--cine-gold-line);
  border-radius: var(--cine-radius, 1.25rem);
  box-shadow: var(--cine-shadow);
  backdrop-filter: blur(18px) saturate(130%);
  -webkit-backdrop-filter: blur(18px) saturate(130%);
  transition: border-color 0.35s ease, box-shadow 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.cine-card:hover {
  border-color: rgba(224, 196, 131, 0.5);
  box-shadow: 0 34px 90px -30px rgba(0, 0, 0, 0.9);
  transform: translateY(-4px);
}

.cine-card--flat:hover {
  transform: none;
}

.cine-panel {
  background: var(--cine-panel-strong);
  border: 1px solid var(--cine-gold-line);
  border-radius: 1.25rem;
  box-shadow: var(--cine-shadow);
}

.cine-section {
  position: relative;
  padding-block: clamp(4.5rem, 10vw, 8.5rem);
}

.cine-container {
  width: 100%;
  max-width: 80rem;
  margin-inline: auto;
  padding-inline: clamp(1.25rem, 5vw, 3rem);
}

.cine-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--font-sans);
  font-size: 0.625rem;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--cine-gold-bright);
}

.cine-eyebrow::before {
  content: '';
  width: 1.75rem;
  height: 1px;
  background: var(--cine-gold);
}

.cine-display {
  font-family: var(--font-serif);
  color: var(--cine-ivory);
  letter-spacing: -0.035em;
  line-height: 0.98;
  text-wrap: balance;
}

.cine-title {
  font-family: var(--font-serif);
  color: var(--cine-ivory);
  letter-spacing: -0.02em;
  line-height: 1.08;
  text-wrap: balance;
}

.cine-lead {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(1.1rem, 2.4vw, 1.45rem);
  line-height: 1.65;
  color: var(--cine-ivory-soft);
  text-wrap: pretty;
}

.cine-body {
  color: var(--cine-ivory-soft);
  line-height: 1.8;
}

.cine-muted {
  color: var(--cine-ivory-muted);
}

.cine-gold-rule {
  display: block;
  width: 4rem;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--cine-gold), transparent);
}

.cine-gold-rule--short {
  width: 2.5rem;
}

.cine-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  border: 1px solid var(--cine-gold-line);
  border-radius: 9999px;
  padding: 0.3rem 0.75rem;
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--cine-gold-bright);
  background: rgba(201, 167, 97, 0.07);
}

/* Cinematic actions retain native button/a semantics. */
.cine-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  border-radius: 9999px;
  padding: 0.85rem 1.6rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--cine-ink);
  background: linear-gradient(135deg, var(--cine-gold-bright), var(--cine-gold));
  border: 1px solid rgba(255, 255, 255, 0.28);
  box-shadow: 0 12px 32px -12px rgba(201, 167, 97, 0.55);
  cursor: pointer;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, filter 0.3s ease;
}

.cine-button:hover {
  transform: translateY(-2px);
  filter: brightness(1.06);
  box-shadow: 0 18px 40px -14px rgba(201, 167, 97, 0.7);
}

.cine-button--ghost {
  color: var(--cine-ivory);
  background: rgba(255, 255, 255, 0.035);
  border-color: var(--cine-gold-line);
  box-shadow: none;
}

.cine-button--ghost:hover {
  color: var(--cine-gold-bright);
  background: rgba(201, 167, 97, 0.09);
  box-shadow: none;
}

/* Image and media framing */
.cine-frame {
  position: relative;
  overflow: hidden;
  border-radius: 1.25rem;
  border: 1px solid var(--cine-gold-line);
  background: var(--cine-ink-raised);
  box-shadow: var(--cine-shadow);
}

.cine-frame img,
.cine-frame video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.cine-frame:hover img,
.cine-frame:hover video {
  transform: scale(1.045);
}

.cine-frame::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, transparent 45%, rgba(8, 9, 7, 0.55) 100%);
}

/* Subtle CSS 3D primitives — no WebGL dependency. */
.cine-scene {
  perspective: 1400px;
  perspective-origin: 50% 40%;
}

.cine-layer {
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.cine-layer--raised {
  transform: translateZ(26px);
}

.cine-layer--floating {
  transform: translateZ(48px) rotateX(1.5deg);
}

.cine-layer--recessed {
  transform: translateZ(-18px);
}

.cine-book-edge {
  background: repeating-linear-gradient(to bottom, #D9CDB5 0px, #F4EFE5 1.5px, #C9BC9F 3px);
  box-shadow: inset -3px 0 8px rgba(0, 0, 0, 0.18), 2px 0 0 rgba(201, 167, 97, 0.35);
}

.cine-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--cine-gold-line), transparent);
}

.cine-scroll-cue {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--cine-ivory-muted);
}

.cine-scroll-cue::after {
  content: '';
  width: 3.5rem;
  height: 1px;
  background: linear-gradient(90deg, var(--cine-gold), transparent);
}

.cine-number {
  font-family: var(--font-serif);
  font-size: clamp(4rem, 11vw, 9rem);
  line-height: 0.85;
  color: rgba(244, 239, 229, 0.045);
  user-select: none;
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .cine-card,
  .cine-card:hover,
  .cine-button,
  .cine-button:hover,
  .cine-layer,
  .cine-frame img,
  .cine-frame video {
    transition: none !important;
    transform: none !important;
  }

  .cine-atmosphere__glow {
    filter: blur(90px);
  }
}

/* ==========================================================================
   CINEMATIC PUBLIC SKIN
   Scoped to public pages only. Admin/member portals keep the original
   high-contrast practical palette because they are not inside this shell.
   ========================================================================== */

.cinematic-shell .glass-nav {
  background: rgba(10, 11, 9, 0.82);
  border-bottom-color: var(--cine-gold-line);
  box-shadow: 0 18px 50px -24px rgba(0, 0, 0, 0.9);
}

.cinematic-shell .glass-panel {
  background: rgba(18, 19, 16, 0.92);
  border-color: var(--cine-gold-line);
  box-shadow: var(--cine-shadow);
}

.cinematic-shell .glass-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018));
  border-color: var(--cine-gold-line);
  box-shadow: var(--cine-shadow);
}

.cinematic-shell .glass-card:hover {
  background: linear-gradient(145deg, rgba(201, 167, 97, 0.09), rgba(255, 255, 255, 0.028));
  border-color: rgba(224, 196, 131, 0.5);
  box-shadow: 0 34px 90px -30px rgba(0, 0, 0, 0.92);
}

.cinematic-shell .glass-pill {
  background: rgba(255, 255, 255, 0.045);
  border-color: var(--cine-gold-line);
  box-shadow: none;
}

.cinematic-shell .glass-button {
  background: linear-gradient(135deg, var(--cine-gold-bright), var(--cine-gold));
  border-color: rgba(255, 255, 255, 0.28);
  color: var(--cine-ink);
  box-shadow: 0 12px 32px -12px rgba(201, 167, 97, 0.55);
}

.cinematic-shell .glass-button:hover {
  background: linear-gradient(135deg, #ECD4A0, var(--cine-gold-bright));
  box-shadow: 0 18px 40px -14px rgba(201, 167, 97, 0.7);
}

.cinematic-shell .glass-button-secondary {
  background: rgba(255, 255, 255, 0.04);
  border-color: var(--cine-gold-line);
  color: var(--cine-ivory);
  box-shadow: none;
}

.cinematic-shell .glass-button-secondary:hover {
  background: rgba(201, 167, 97, 0.1);
  border-color: rgba(224, 196, 131, 0.5);
  color: var(--cine-gold-bright);
  box-shadow: none;
}

.cinematic-shell .glass-input {
  background: rgba(255, 255, 255, 0.045);
  border-color: var(--cine-gold-line);
  color: var(--cine-ivory);
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2);
}

.cinematic-shell .glass-input::placeholder {
  color: var(--cine-ivory-muted);
}

.cinematic-shell .glass-input:focus {
  background: rgba(255, 255, 255, 0.075);
  border-color: var(--cine-gold);
  box-shadow: 0 0 0 3px rgba(201, 167, 97, 0.14);
}

.cinematic-shell .glass-modal {
  background: rgba(16, 17, 14, 0.96);
  border-color: var(--cine-gold-line);
  color: var(--cine-ivory);
  box-shadow: 0 30px 90px -20px rgba(0, 0, 0, 0.95);
}

/* Paper cards need cast shadows on near-black — the light-theme shadow is
   invisible here. The base :hover transform and transition remain intact. */
.cinematic-shell .paper-card {
  background: rgba(255, 255, 255, 0.04);
  border-color: var(--cine-gold-line);
  color: var(--cine-ivory);
  box-shadow: 0 14px 34px -12px rgba(0, 0, 0, 0.72), 0 4px 14px -4px rgba(0, 0, 0, 0.45);
}

.cinematic-shell .paper-card:hover {
  border-color: var(--cine-gold);
  box-shadow: 0 20px 46px -14px rgba(0, 0, 0, 0.82), 0 6px 18px -4px rgba(0, 0, 0, 0.55);
}

.cinematic-shell .glass-dark {
  background: rgba(10, 11, 9, 0.9);
  border-color: var(--cine-gold-line);
}

/* Re-map the legacy ink palette to the dark editorial palette on public pages.
   Selectors are anchored to whole class tokens (^= or a leading space) so variant
   prefixes such as hover:, group-hover: and focus: are NOT matched. That keeps
   Tailwind's interactive utilities alive instead of freezing them as base styles.
   Opacity modifiers (e.g. text-[#F2EBDD]/95) remain covered by the ^= form. */
.cinematic-shell [class^="text-[#20231F]"],
.cinematic-shell [class*=" text-[#20231F]"],
.cinematic-shell [class^="text-[#1C1B1A]"],
.cinematic-shell [class*=" text-[#1C1B1A]"],
.cinematic-shell [class^="text-[#2D2721]"],
.cinematic-shell [class*=" text-[#2D2721]"],
.cinematic-shell [class^="text-[#2A2826]"],
.cinematic-shell [class*=" text-[#2A2826]"],
.cinematic-shell [class^="text-[#2E372B]"],
.cinematic-shell [class*=" text-[#2E372B]"],
.cinematic-shell [class^="text-[#1c1f1a]"],
.cinematic-shell [class*=" text-[#1c1f1a]"] {
  color: var(--cine-ivory);
}

/* Muted ink becomes soft ivory. */
.cinematic-shell [class^="text-[#595550]"],
.cinematic-shell [class*=" text-[#595550]"],
.cinematic-shell [class^="text-[#77736D]"],
.cinematic-shell [class*=" text-[#77736D]"],
.cinematic-shell [class^="text-[#8C857B]"],
.cinematic-shell [class*=" text-[#8C857B]"],
.cinematic-shell [class^="text-[#8D5B4C]"],
.cinematic-shell [class*=" text-[#8D5B4C]"],
.cinematic-shell [class^="text-[#B4ADA2]"],
.cinematic-shell [class*=" text-[#B4ADA2]"],
.cinematic-shell [class^="text-[#C9C2B6]"],
.cinematic-shell [class*=" text-[#C9C2B6]"],
.cinematic-shell [class^="text-[#C7BDB0]"],
.cinematic-shell [class*=" text-[#C7BDB0]"],
.cinematic-shell [class^="text-[#D4CCC0]"],
.cinematic-shell [class*=" text-[#D4CCC0]"] {
  color: var(--cine-ivory-soft);
}

/* Accent ink becomes bright gold. */
.cinematic-shell [class^="text-[#777C60]"],
.cinematic-shell [class*=" text-[#777C60]"],
.cinematic-shell [class^="text-[#455240]"],
.cinematic-shell [class*=" text-[#455240]"],
.cinematic-shell [class^="text-[#A65F46]"],
.cinematic-shell [class*=" text-[#A65F46]"],
.cinematic-shell [class^="text-[#B88B4A]"],
.cinematic-shell [class*=" text-[#B88B4A]"],
.cinematic-shell [class^="text-[#B89A65]"],
.cinematic-shell [class*=" text-[#B89A65]"] {
  color: var(--cine-gold-bright);
}

.cinematic-shell [class^="text-[#F2EBDD]"],
.cinematic-shell [class*=" text-[#F2EBDD]"],
.cinematic-shell [class^="text-[#FAF8F5]"],
.cinematic-shell [class*=" text-[#FAF8F5]"],
.cinematic-shell [class^="text-[#E5DFD4]"],
.cinematic-shell [class*=" text-[#E5DFD4]"],
.cinematic-shell [class^="text-[#F4EFEA]"],
.cinematic-shell [class*=" text-[#F4EFEA]"],
.cinematic-shell [class^="text-[#E8E2D5]"],
.cinematic-shell [class*=" text-[#E8E2D5]"],
.cinematic-shell [class^="text-[#E8ECE0]"],
.cinematic-shell [class*=" text-[#E8ECE0]"],
.cinematic-shell [class^="text-[#EBF0E9]"],
.cinematic-shell [class*=" text-[#EBF0E9]"] {
  color: var(--cine-ivory);
}

/* Light paper surfaces become raised glass panels. */
.cinematic-shell [class^="bg-white"],
.cinematic-shell [class*=" bg-white"],
.cinematic-shell [class^="bg-[#FAF8F5]"],
.cinematic-shell [class*=" bg-[#FAF8F5]"],
.cinematic-shell [class^="bg-[#FBF8F3]"],
.cinematic-shell [class*=" bg-[#FBF8F3]"],
.cinematic-shell [class^="bg-[#F7EBE7]"],
.cinematic-shell [class*=" bg-[#F7EBE7]"],
.cinematic-shell [class^="bg-[#F4EFEA]"],
.cinematic-shell [class*=" bg-[#F4EFEA]"],
.cinematic-shell [class^="bg-[#F3ECDD]"],
.cinematic-shell [class*=" bg-[#F3ECDD]"],
.cinematic-shell [class^="bg-[#F2EBDD]"],
.cinematic-shell [class*=" bg-[#F2EBDD]"],
.cinematic-shell [class^="bg-[#EBF0E9]"],
.cinematic-shell [class*=" bg-[#EBF0E9]"],
.cinematic-shell [class^="bg-[#E8ECE0]"],
.cinematic-shell [class*=" bg-[#E8ECE0]"],
.cinematic-shell [class^="bg-[#E8E2D5]"],
.cinematic-shell [class*=" bg-[#E8E2D5]"],
.cinematic-shell [class^="bg-[#E5DFD4]"],
.cinematic-shell [class*=" bg-[#E5DFD4]"],
.cinematic-shell [class^="bg-[#D8D3C8]"],
.cinematic-shell [class*=" bg-[#D8D3C8]"] {
  background-color: var(--cine-panel-strong);
}

/* Existing dark structural surfaces become deeper ink with a gold edge. */
.cinematic-shell [class^="bg-[#20231F]"],
.cinematic-shell [class*=" bg-[#20231F]"],
.cinematic-shell [class^="bg-[#1C1B1A]"],
.cinematic-shell [class*=" bg-[#1C1B1A]"],
.cinematic-shell [class^="bg-[#211F1C]"],
.cinematic-shell [class*=" bg-[#211F1C]"],
.cinematic-shell [class^="bg-[#171615]"],
.cinematic-shell [class*=" bg-[#171615]"],
.cinematic-shell [class^="bg-[#2A2826]"],
.cinematic-shell [class*=" bg-[#2A2826]"] {
  background-color: var(--cine-ink-raised);
}

.cinematic-shell [class^="border-[#E8E2D5]"],
.cinematic-shell [class*=" border-[#E8E2D5]"],
.cinematic-shell [class^="border-[#E5DFD4]"],
.cinematic-shell [class*=" border-[#E5DFD4]"],
.cinematic-shell [class^="border-[#363330]"],
.cinematic-shell [class*=" border-[#363330]"],
.cinematic-shell [class^="border-[#D8D3C8]"],
.cinematic-shell [class*=" border-[#D8D3C8]"],
.cinematic-shell [class^="border-[#F4EFEA]"],
.cinematic-shell [class*=" border-[#F4EFEA]"],
.cinematic-shell [class^="border-[#C8C0B2]"],
.cinematic-shell [class*=" border-[#C8C0B2]"],
.cinematic-shell [class^="border-[#777C60]"],
.cinematic-shell [class*=" border-[#777C60]"],
.cinematic-shell [class^="border-[#455240]"],
.cinematic-shell [class*=" border-[#455240]"] {
  border-color: var(--cine-gold-line);
}

.cinematic-shell [class^="placeholder-[#8C857B]"]::placeholder,
.cinematic-shell [class*=" placeholder-[#8C857B]"]::placeholder {
  color: var(--cine-ivory-muted);
}

/* Status pills keep their meaning but use restrained gold accents. */
.cinematic-shell :is([class^="bg-[#EBF0E9]"], [class*=" bg-[#EBF0E9]"]):is([class^="text-[#2E372B]"], [class*=" text-[#2E372B]"]) {
  background: rgba(201, 167, 97, 0.12);
  color: var(--cine-gold-bright);
}

/* The one arbitrary paper gradient is remapped without changing the class. */
.cinematic-shell [class^="bg-[linear-gradient(135deg,rgba(250"],
.cinematic-shell [class*=" bg-[linear-gradient(135deg,rgba(250"] {
  background: linear-gradient(135deg, rgba(20, 21, 17, 0.96), rgba(11, 12, 9, 0.92));
}

/* --------------------------------------------------------------------------
   INTERACTIVE STATES
   The base remaps above now match whole class tokens only, so Tailwind's
   hover:, group-hover: and focus: utilities are free to change state again.
   Their original light-theme colours would be invisible on near-black, so the
   interactive values are remapped to the editorial palette with scoped rules.
   These are unlayered and therefore outrank Tailwind's layered utilities;
   admin and password-recovery pages live outside .cinematic-shell.
   -------------------------------------------------------------------------- */

/* Legacy arbitrary-hex hover text (the `hover:` substring also covers
   `group-hover:`) becomes bright gold. `.group:hover` also covers children that
   are not directly pointer-targetable. */
.cinematic-shell [class*="hover:text-[#"]:hover,
.cinematic-shell .group:hover [class*="hover:text-[#"] {
  color: var(--cine-gold-bright);
}

/* Light hover fills would flash white. Keep them as restrained raised surfaces.
   The 10% glass hover and the WhatsApp green hover are intentionally untouched. */
.cinematic-shell [class*="hover:bg-white"]:not([class*="hover:bg-white/10"]):hover,
.cinematic-shell [class*="hover:bg-[#FAF8F5]"]:hover,
.cinematic-shell [class*="hover:bg-[#F4EFEA]"]:hover,
.cinematic-shell [class*="hover:bg-[#EBF0E9]"]:hover,
.cinematic-shell [class*="hover:bg-[#E8E2D5]"]:hover,
.cinematic-shell .group:hover [class*="hover:bg-[#F4EFEA]"] {
  background-color: rgba(255, 255, 255, 0.09);
}

/* Hover borders stay visible instead of blending into the dark surface. */
.cinematic-shell [class*="hover:border-[#"]:hover,
.cinematic-shell .group:hover [class*="hover:border-[#"] {
  border-color: var(--cine-gold);
}

/* Focused form controls keep a gold edge alongside the existing focus outline. */
.cinematic-shell input[class*="focus:border-[#"]:focus,
.cinematic-shell select[class*="focus:border-[#"]:focus,
.cinematic-shell textarea[class*="focus:border-[#"]:focus {
  border-color: var(--cine-gold-bright);
}

/* Active navigation indicator: the legacy ink underline is remapped to near-black
   by the surface rules above, so make the animated 2px bar a visible gold rule. */
.cinematic-shell nav [class*="h-[2px]"][class*="bg-[#1C1B1A]"] {
  background: var(--cine-gold-bright) !important;
  box-shadow: 0 0 12px rgba(201, 167, 97, 0.5);
}

/* The mobile active item gets the same gold cue on its leading edge. */
.cinematic-shell #mobile-navigation button[class*="bg-[#E8E2D5]/70"] {
  box-shadow: inset 3px 0 0 var(--cine-gold-bright);
}

/* Inline philosophy accents need a brighter gold against the dark shell. */
.cinematic-shell span[style*="rgb(166, 95, 70)"]:not([class*="text-5xl"]),
.cinematic-shell span[style*="#A65F46"]:not([class*="text-5xl"]),
.cinematic-shell span[style*="#a65f46"]:not([class*="text-5xl"]) {
  color: var(--cine-gold-bright) !important;
}

/* WhatsApp keeps its brand green; ink text restores AA contrast on it. */
.cinematic-shell a[class*="bg-[#25D366]"] {
  color: var(--cine-ink) !important;
}

/* Gold-forward primary CTAs keep their original click targets and labels. */
.cinematic-shell button[class*="bg-[#F2EBDD]"],
.cinematic-shell button[class*="bg-[#1C1B1A]"] {
  background: linear-gradient(135deg, var(--cine-gold-bright), var(--cine-gold)) !important;
  color: var(--cine-ink) !important;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 12px 32px -12px rgba(201, 167, 97, 0.55);
}

.cinematic-shell button[class*="bg-[#F2EBDD]"]:hover,
.cinematic-shell button[class*="bg-[#1C1B1A]"]:hover {
  filter: brightness(1.06);
}

/* Compact controls and status actions keep dark ink on a gold surface. */
.cinematic-shell button[class*="bg-white/90"],
.cinematic-shell button[class*="bg-[#455240]"],
.cinematic-shell button[class*="bg-[#EBF0E9]"],
.cinematic-shell button[class*="bg-[#FAF8F5]"]:not([class*="glass"]) {
  background: linear-gradient(135deg, var(--cine-gold-bright), var(--cine-gold)) !important;
  color: var(--cine-ink) !important;
  border-color: rgba(255, 255, 255, 0.3) !important;
}

/* Media controls over video stay glassy and legible. */
.cinematic-shell .glass-dark-control {
  background: rgba(10, 11, 9, 0.62);
  border: 1px solid var(--cine-gold-line);
}

/* Hero and footer get a restrained editorial frame without new DOM. */
.cinematic-shell [aria-label="Readers of Aurangabad community hero"]::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(8, 9, 7, 0.55) 0%, transparent 46%),
    linear-gradient(0deg, rgba(8, 9, 7, 0.9) 0%, transparent 42%);
}

.cinematic-shell [aria-label="Readers of Aurangabad community hero"] picture,
.cinematic-shell [aria-label="Readers of Aurangabad community hero"] img {
  filter: saturate(0.88) contrast(1.04);
}

.cinematic-shell footer::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--cine-gold), transparent);
  pointer-events: none;
}

.cinematic-shell .editorial-number {
  color: rgba(244, 239, 229, 0.045);
}

.cinematic-shell .section-rule {
  background-color: var(--cine-gold);
}

.cinematic-shell .cine-gold-rule {
  opacity: 0.9;
}

@media (prefers-reduced-motion: reduce) {
  .cinematic-shell .glass-card,
  .cinematic-shell .glass-card:hover,
  .cinematic-shell .glass-button,
  .cinematic-shell .glass-button:hover,
  .cinematic-shell [aria-label="Readers of Aurangabad community hero"] img {
    transition: none !important;
    transform: none !important;
  }
}

/* ==========================================================================
   PRACTICAL PORTAL FINISH
   Admin and recovery stay light, dense, and readable — only focus and table
   affordances are sharpened. No admin logic, copy, or workflow is touched.
   ========================================================================== */

.admin-shell {
  background: linear-gradient(180deg, #FAF8F5 0%, #F6F1E8 100%);
}

.admin-shell :is(a, button, input, select, textarea):focus-visible {
  outline: 2px solid #A65F46;
  outline-offset: 2px;
}

.admin-shell thead {
  background-color: rgba(32, 35, 31, 0.04);
}

.cinematic-shell .p2-page {
  position: relative;
}

.cinematic-shell .p2-page .grid > * {
  min-width: 0;
}

/* Shared hero grammar: a quiet left-to-right light falloff so each chapter
   keeps its own photograph while the headline stays legible. */
.cinematic-shell .p2-hero {
  isolation: isolate;
}

.cinematic-shell .p2-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(8, 9, 7, 0.52) 0%, rgba(8, 9, 7, 0.08) 48%, transparent 76%);
}

.cinematic-shell .p2-hero img {
  filter: saturate(0.78) contrast(1.06) sepia(0.07);
}

.cinematic-shell .p2-hero-copy {
  max-width: 68rem;
}

.cinematic-shell .p2-hero-copy h1 {
  letter-spacing: -0.055em;
  text-shadow: 0 8px 40px rgba(0, 0, 0, 0.42);
}

.cinematic-shell .p2-hero-copy > p:last-of-type {
  padding-left: 1rem;
  border-left: 1px solid var(--cine-gold);
}

.cinematic-shell .p2-chapter-heading {
  position: relative;
}

.cinematic-shell .p2-chapter-heading h2,
.cinematic-shell .p2-chapter-heading h3 {
  line-height: 1.06;
  letter-spacing: -0.03em;
  text-wrap: balance;
}

@media (min-width: 768px) {
  .cinematic-shell .p2-chapter-heading {
    padding-left: 1.25rem;
  }

  .cinematic-shell .p2-chapter-heading::before {
    content: '';
    position: absolute;
    top: 0.35rem;
    bottom: 1.75rem;
    left: 0;
    width: 1px;
    background: linear-gradient(180deg, var(--cine-gold), transparent);
  }
}

.cinematic-shell .p2-empty-state {
  border-color: var(--cine-gold-line) !important;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.015)) !important;
}

.cinematic-shell .p2-empty-state::before {
  content: '';
  display: block;
  width: 3rem;
  height: 1px;
  margin: 0 auto 0.5rem;
  background: linear-gradient(90deg, transparent, var(--cine-gold), transparent);
}

/* ── Our Story: manuscript, marginalia, photographic chronicle ─────────── */

.cinematic-shell .p2-hero--story::after {
  background:
    linear-gradient(90deg, rgba(8, 9, 7, 0.62) 0%, rgba(8, 9, 7, 0.12) 52%, transparent 78%),
    linear-gradient(0deg, rgba(8, 9, 7, 0.42) 0%, transparent 46%);
}

.cinematic-shell .p2-story-intro {
  position: relative;
  padding-block: clamp(1rem, 4vw, 3rem);
}

.cinematic-shell .p2-story-intro::after {
  content: '';
  display: block;
  width: 3rem;
  height: 1px;
  margin: 1.5rem auto 0;
  background: linear-gradient(90deg, transparent, var(--cine-gold), transparent);
}

.cinematic-shell .p2-story-intro p {
  color: var(--cine-ivory);
  font-size: clamp(1.25rem, 3vw, 2rem);
  line-height: 1.55;
  letter-spacing: -0.015em;
  text-wrap: pretty;
}

.cinematic-shell .p2-manuscript {
  border-left: 1px solid var(--cine-gold-line);
  box-shadow: 0 26px 70px -34px rgba(0, 0, 0, 0.9);
}

.cinematic-shell .p2-manuscript > p:first-child {
  font-size: clamp(1.35rem, 3.2vw, 2rem);
  line-height: 1.35;
  letter-spacing: -0.02em;
}

.cinematic-shell .p2-manuscript > p:first-child::first-letter {
  float: left;
  padding: 0.08em 0.12em 0 0;
  color: var(--cine-gold-bright);
  font-family: var(--font-serif);
  font-size: 3.4em;
  line-height: 0.78;
}

.cinematic-shell .p2-manuscript > p:not(:first-child) {
  max-width: 46rem;
}

.cinematic-shell .p2-marginalia {
  border-top: 1px solid var(--cine-gold-line) !important;
  background: linear-gradient(145deg, rgba(201, 167, 97, 0.07), rgba(255, 255, 255, 0.018)) !important;
}

.cinematic-shell .p2-tenet-grid > .paper-card {
  position: relative;
  padding-top: 2rem;
}

.cinematic-shell .p2-tenet-grid > .paper-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 2rem;
  left: 2rem;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--cine-gold), transparent);
}

.cinematic-shell .p2-founder-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.06), rgba(201, 167, 97, 0.025));
}

.cinematic-shell .p2-founder-card img {
  filter: saturate(0.82) sepia(0.1);
}

.cinematic-shell .p2-founder-words {
  color: var(--cine-ivory-soft);
}

@media (min-width: 768px) {
  .cinematic-shell .p2-founder-words {
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
    border-left: 1px solid var(--cine-gold-line);
  }
}

.cinematic-shell .p2-founder-words > p:first-of-type {
  color: var(--cine-ivory);
  font-size: clamp(1.15rem, 2.4vw, 1.5rem);
}

.cinematic-shell .p2-chronicle-grid > .paper-card {
  border-top: 1px solid var(--cine-gold-line);
}

.cinematic-shell .p2-chronicle-grid > .paper-card:nth-child(2) img {
  object-position: center 35%;
}

.cinematic-shell .p2-steward-grid > .paper-card:last-child {
  border-color: rgba(201, 167, 97, 0.45) !important;
  background: linear-gradient(145deg, rgba(201, 167, 97, 0.12), rgba(255, 255, 255, 0.025)) !important;
}

/* ── Gatherings: printed programme, event imagery, clear meetup rails ─── */

.cinematic-shell .p2-hero--gatherings::after {
  background:
    linear-gradient(90deg, rgba(8, 9, 7, 0.66) 0%, rgba(8, 9, 7, 0.1) 56%, transparent 80%),
    repeating-linear-gradient(90deg, transparent 0 119px, rgba(201, 167, 97, 0.035) 119px 120px);
}

.cinematic-shell .p2-gathering-filters {
  justify-content: flex-start;
}

.cinematic-shell .p2-gathering-filters button[data-active='true'] {
  border-color: var(--cine-gold-bright) !important;
  box-shadow: 0 14px 34px -16px rgba(201, 167, 97, 0.9);
}

.cinematic-shell .p2-experience-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.018));
}

.cinematic-shell .p2-itinerary > div {
  padding-top: 1rem;
  border-top: 1px solid var(--cine-gold-line);
}

.cinematic-shell .p2-itinerary > div > span:first-child {
  color: var(--cine-gold-bright);
  font-size: 1.5rem;
}

@media (min-width: 1024px) {
  .cinematic-shell .p2-itinerary {
    gap: 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .cinematic-shell .p2-itinerary > div {
    padding-top: 0;
    padding-left: 1.5rem;
    border-top: 0;
    border-left: 1px solid var(--cine-gold-line);
  }

  .cinematic-shell .p2-itinerary > div:first-child {
    padding-left: 0;
    border-left: 0;
  }
}

.cinematic-shell .p2-philosophy-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(201, 167, 97, 0.02));
}

.cinematic-shell .p2-principles > div {
  border-top: 1px solid var(--cine-gold-line);
}

.cinematic-shell .p2-core-belief {
  border-left: 2px solid var(--cine-gold);
  background: linear-gradient(120deg, rgba(20, 21, 17, 0.96), rgba(11, 12, 9, 0.88));
}

@media (min-width: 1024px) {
  .cinematic-shell .p2-philosophy-card {
    display: grid;
    column-gap: 3rem;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  }

  .cinematic-shell .p2-philosophy-heading {
    grid-column: 1;
  }

  .cinematic-shell .p2-principles {
    grid-column: 2;
  }

  .cinematic-shell .p2-core-belief {
    grid-column: 1 / -1;
  }
}

.cinematic-shell .p2-meetup-grid {
  align-items: stretch;
}

.cinematic-shell .p2-meetup-card {
  height: 100%;
}

.cinematic-shell .p2-meetup-image {
  height: 14rem;
}

.cinematic-shell .p2-meetup-image::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(0deg, rgba(8, 9, 7, 0.52), transparent 58%);
}

@media (min-width: 768px) {
  .cinematic-shell .p2-meetup-image {
    height: 16rem;
  }
}

.cinematic-shell .p2-meetup-info h3 {
  font-size: clamp(1.4rem, 2.4vw, 1.8rem);
  line-height: 1.14;
  letter-spacing: -0.025em;
}

.cinematic-shell .p2-meetup-actions a {
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: var(--cine-ink) !important;
  background: linear-gradient(135deg, var(--cine-gold-bright), var(--cine-gold)) !important;
  box-shadow: 0 12px 30px -14px rgba(201, 167, 97, 0.7);
}

.cinematic-shell .p2-meetup-actions button {
  position: relative;
}

.cinematic-shell .p2-meetup-actions button::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: -2px;
  left: 0;
  height: 1px;
  background: var(--cine-gold);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s ease;
}

.cinematic-shell .p2-meetup-actions button:hover::after {
  transform: scaleX(1);
}

/* ── Community: photo essay, pull quotes, gallery plates ───────────────── */

.cinematic-shell .p2-hero--community::after {
  background:
    linear-gradient(0deg, rgba(8, 9, 7, 0.82) 0%, transparent 58%),
    linear-gradient(90deg, rgba(8, 9, 7, 0.34), transparent 72%);
}

.cinematic-shell .p2-voice-card {
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.015));
}

.cinematic-shell .p2-voice-grid > :first-child {
  border-left: 2px solid var(--cine-gold);
}

.cinematic-shell .p2-voice-card > span:first-child {
  color: rgba(244, 239, 229, 0.38);
  font-size: 4.5rem;
}

.cinematic-shell .p2-voice-card > div:last-child {
  border-top-color: var(--cine-gold-line);
}

.cinematic-shell .p2-gallery-frame {
  padding: clamp(1rem, 3vw, 2rem);
  border: 1px solid var(--cine-gold-line);
  border-radius: 1.75rem;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.012));
  box-shadow: var(--cine-shadow);
}

.cinematic-shell .p2-steward-grid > .p2-steward-card {
  border-left: 2px solid var(--cine-gold-line);
}

.cinematic-shell .p2-steward-card img {
  border-color: var(--cine-gold-line);
}

.cinematic-shell .p2-community-invite {
  padding-block: 2.5rem;
  border-top: 1px solid var(--cine-gold-line);
  border-bottom: 1px solid var(--cine-gold-line);
}

/* ── Journal: catalogue index, folio rules, magazine covers ────────────── */

.cinematic-shell .p2-hero--journal::after {
  background:
    linear-gradient(180deg, rgba(8, 9, 7, 0.28), rgba(8, 9, 7, 0.78)),
    linear-gradient(90deg, rgba(8, 9, 7, 0.5), transparent 72%);
}

.cinematic-shell .p2-journal-search input {
  border-radius: 0.9rem;
  border-left: 2px solid var(--cine-gold);
}

.cinematic-shell .p2-category-bar {
  gap: 0.4rem;
}

.cinematic-shell .p2-category-bar button {
  letter-spacing: 0.06em;
}

.cinematic-shell .p2-category-bar button[data-active='true'] {
  box-shadow: 0 10px 26px -14px rgba(201, 167, 97, 0.75);
}

.cinematic-shell .p2-language-bar {
  border-top-color: var(--cine-gold-line);
}

.cinematic-shell .p2-language-bar button[data-active='true'] {
  box-shadow: inset 0 -1px 0 var(--cine-gold-bright);
}

.cinematic-shell .p2-article-card {
  border-top: 1px solid var(--cine-gold-line);
}

.cinematic-shell .p2-article-card:nth-child(3n + 1) {
  border-top-color: var(--cine-gold);
}

.cinematic-shell .p2-article-image {
  height: 13rem;
}

@media (min-width: 768px) {
  .cinematic-shell .p2-article-image {
    height: 15rem;
  }

  .cinematic-shell .p2-article-card:first-child .p2-article-image {
    height: 17rem;
  }
}

.cinematic-shell .p2-article-body h3 {
  font-size: clamp(1.35rem, 2.4vw, 1.75rem);
  line-height: 1.12;
  letter-spacing: -0.02em;
  text-wrap: balance;
}

.cinematic-shell .p2-article-footer {
  border-top-color: var(--cine-gold-line);
}

.cinematic-shell .p2-article-footer button {
  position: relative;
}

.cinematic-shell .p2-article-footer button::after {
  content: '';
  position: absolute;
  right: 1rem;
  bottom: 0.35rem;
  left: 1rem;
  height: 1px;
  background: var(--cine-gold);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s ease;
}

.cinematic-shell .p2-article-footer button:hover::after {
  transform: scaleX(1);
}

.cinematic-shell .p2-journal-submit > .paper-card {
  border-left: 2px solid var(--cine-gold);
  background: linear-gradient(120deg, rgba(201, 167, 97, 0.1), rgba(255, 255, 255, 0.025));
}

/* ── Contact: letterhead, legible methods, calm form desk ──────────────── */

.cinematic-shell .p2-hero--contact::after {
  background:
    linear-gradient(0deg, rgba(8, 9, 7, 0.78) 0%, transparent 58%),
    linear-gradient(90deg, rgba(8, 9, 7, 0.46), transparent 74%);
}

.cinematic-shell .p2-contact-card,
.cinematic-shell .p2-contact-form-card {
  border-top: 2px solid var(--cine-gold);
}

.cinematic-shell .p2-contact-method > div:first-child {
  border-color: var(--cine-gold-line) !important;
  background: rgba(201, 167, 97, 0.08) !important;
}

.cinematic-shell .p2-contact-method p {
  overflow-wrap: anywhere;
}

.cinematic-shell .p2-contact-photo {
  border-color: var(--cine-gold-line);
}

.cinematic-shell .p2-contact-photo img {
  height: 13rem;
}

.cinematic-shell .p2-contact-quote {
  border-left: 2px solid var(--cine-gold);
}

.cinematic-shell .p2-contact-form label,
.cinematic-shell .p2-participation-form label {
  letter-spacing: 0.02em;
}

/* ── Get Involved: two doorways, participation desk, closing colophon ──── */

.cinematic-shell .p2-hero--involved::after {
  background:
    linear-gradient(90deg, rgba(8, 9, 7, 0.64) 0%, rgba(8, 9, 7, 0.12) 55%, transparent 80%),
    linear-gradient(0deg, rgba(8, 9, 7, 0.48) 0%, transparent 48%);
}

.cinematic-shell .p2-involved-banner {
  border-color: var(--cine-gold-line);
}

.cinematic-shell .p2-involved-banner img {
  filter: saturate(0.8) contrast(1.05);
}

.cinematic-shell .p2-action-grid {
  position: relative;
}

.cinematic-shell .p2-action-card {
  position: relative;
  z-index: 1;
  border-top: 2px solid var(--cine-gold);
}

.cinematic-shell .p2-action-card:nth-child(2) {
  border-top-color: rgba(201, 167, 97, 0.35);
}

@media (min-width: 768px) {
  .cinematic-shell .p2-action-grid::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 2rem;
    left: 2rem;
    z-index: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cine-gold-line), transparent);
  }
}

.cinematic-shell .p2-participation-card {
  border-top: 2px solid var(--cine-gold);
}

.cinematic-shell .p2-participation-tabs button[data-active='true'] {
  box-shadow:
    0 12px 30px -16px rgba(201, 167, 97, 0.85),
    inset 0 0 0 1px rgba(224, 196, 131, 0.45);
}

.cinematic-shell .p2-participation-callout {
  border-left: 2px solid var(--cine-gold);
}

.cinematic-shell .p2-future-horizon {
  padding-top: 2.5rem;
  border-top: 1px solid var(--cine-gold-line);
}

@media (prefers-reduced-motion: reduce) {
  .cinematic-shell .p2-page *,
  .cinematic-shell .p2-page *::before,
  .cinematic-shell .p2-page *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ==========================================================================
   P3 — PREMIUM MODALS, FORMS & FOOTER
   Additive presentation hooks only. Class names begin with p3- so this layer
   cannot silently restyle admin forms or the light recovery shell. Existing
   handlers, validation, consent, scroll behaviour and z-index stay untouched.
   ========================================================================== */

/* ── Public modal overlays and surfaces ──────────────────────────────────── */

.cinematic-shell .p3-modal-overlay {
  background:
    radial-gradient(circle at 50% 0%, rgba(201, 167, 97, 0.1), transparent 42%),
    linear-gradient(180deg, rgba(5, 6, 5, 0.82), rgba(5, 6, 5, 0.94));
  backdrop-filter: blur(14px) saturate(120%);
  -webkit-backdrop-filter: blur(14px) saturate(120%);
}

.cinematic-shell .p3-modal-backdrop {
  background:
    radial-gradient(circle at 50% 45%, rgba(201, 167, 97, 0.07), transparent 45%),
    rgba(5, 6, 5, 0.95) !important;
}

.cinematic-shell .p3-modal-surface {
  background:
    radial-gradient(ellipse 80% 30% at 50% 0%, rgba(201, 167, 97, 0.1), transparent 62%),
    linear-gradient(155deg, rgba(22, 23, 19, 0.98), rgba(10, 11, 9, 0.98)) !important;
  border: 1px solid var(--cine-gold-line) !important;
  color: var(--cine-ivory);
  box-shadow:
    0 40px 120px -30px rgba(0, 0, 0, 0.96),
    inset 0 1px 0 rgba(224, 196, 131, 0.12);
}

.cinematic-shell .p3-modal-surface::before {
  content: '';
  position: absolute;
  top: 0;
  right: 1.5rem;
  left: 1.5rem;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(224, 196, 131, 0.65), transparent);
  pointer-events: none;
  z-index: 30;
}

/* The member sign-in overlay lives inside the sticky glass header. Its own
   backdrop-filter turns the header into the containing block for fixed
   children, so the dialog used to anchor to the 80px header and clip. Suspend
   that blur only while the dialog is open; the scrim hides the difference and
   all handlers, stacking and dismissal behaviour remain unchanged. */
body:has(.p3-signin-modal) header.glass-nav {
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

.cinematic-shell .p3-modal-header {
  border-bottom: 1px solid var(--cine-gold-line) !important;
}

.cinematic-shell .p3-article-modal .p3-modal-header {
  background: rgba(8, 9, 7, 0.72) !important;
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.cinematic-shell .p3-meetup-modal .p3-modal-header::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(5, 6, 5, 0.28) 0%, transparent 38%),
    linear-gradient(0deg, rgba(5, 6, 5, 0.86) 0%, transparent 55%);
  pointer-events: none;
}

.cinematic-shell .p3-meetup-modal .p3-modal-header img,
.cinematic-shell .p3-meetup-modal .p3-modal-header > div:last-child,
.cinematic-shell .p3-meetup-modal .p3-modal-header button {
  position: relative;
}

.cinematic-shell .p3-meetup-modal .p3-modal-header img {
  z-index: 0;
}

.cinematic-shell .p3-meetup-modal .p3-modal-header > div:last-child,
.cinematic-shell .p3-meetup-modal .p3-modal-header button {
  z-index: 10;
}

.cinematic-shell .p3-modal-body {
  color: var(--cine-ivory-soft);
  scrollbar-color: rgba(201, 167, 97, 0.45) transparent;
}

.cinematic-shell .p3-modal-body h1,
.cinematic-shell .p3-modal-body h2,
.cinematic-shell .p3-modal-body h3,
.cinematic-shell .p3-modal-body h4 {
  color: var(--cine-ivory);
}

.cinematic-shell .p3-reading-body .prose {
  color: var(--cine-ivory-soft);
}

.cinematic-shell .p3-modal-actions {
  background: linear-gradient(180deg, rgba(18, 19, 16, 0.97), rgba(10, 11, 9, 0.98)) !important;
  border-top: 1px solid var(--cine-gold-line) !important;
}

.cinematic-shell .p3-modal-meta,
.cinematic-shell .p3-modal-meta > div {
  background: rgba(255, 255, 255, 0.035) !important;
  border-color: var(--cine-gold-line) !important;
}

.cinematic-shell .p3-status-chip {
  background: rgba(201, 167, 97, 0.12) !important;
  border-color: var(--cine-gold-line) !important;
  color: var(--cine-gold-bright) !important;
}

/* ── Shared controls inside public overlays ──────────────────────────────── */

.cinematic-shell .p3-icon-button {
  color: var(--cine-ivory-soft);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--cine-gold-line);
  transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.cinematic-shell .p3-meetup-modal .p3-modal-close {
  background: rgba(8, 9, 7, 0.72);
}

.cinematic-shell .p3-icon-button:hover {
  color: var(--cine-gold-bright);
  background: rgba(201, 167, 97, 0.14);
  border-color: var(--cine-gold);
}

.cinematic-shell .p3-primary-action,
.cinematic-shell .p3-form-submit {
  background: linear-gradient(135deg, var(--cine-gold-bright), var(--cine-gold)) !important;
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: var(--cine-ink) !important;
  box-shadow: 0 14px 34px -14px rgba(201, 167, 97, 0.7);
}

.cinematic-shell .p3-primary-action:hover,
.cinematic-shell .p3-form-submit:not(:disabled):hover {
  filter: brightness(1.06);
}

.cinematic-shell .p3-form-submit:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  filter: saturate(0.7);
  box-shadow: none;
}

.cinematic-shell .p3-secondary-action {
  background: rgba(255, 255, 255, 0.04) !important;
  border-color: var(--cine-gold-line) !important;
  color: var(--cine-ivory-soft) !important;
}

.cinematic-shell .p3-secondary-action:hover {
  background: rgba(201, 167, 97, 0.1) !important;
  border-color: var(--cine-gold) !important;
  color: var(--cine-gold-bright) !important;
}

.cinematic-shell .p3-text-action {
  color: var(--cine-ivory-soft);
  transition: color 0.2s ease, background-color 0.2s ease;
}

.cinematic-shell .p3-text-action:hover {
  color: var(--cine-gold-bright);
}

.cinematic-shell .p3-icon-button:focus-visible,
.cinematic-shell .p3-primary-action:focus-visible,
.cinematic-shell .p3-secondary-action:focus-visible,
.cinematic-shell .p3-text-action:focus-visible,
.cinematic-shell .p3-form-submit:focus-visible,
.cinematic-shell .p3-segmented-button:focus-visible {
  outline: 2px solid var(--cine-gold-bright);
  outline-offset: 3px;
}

/* ── Public forms and validation states ──────────────────────────────────── */

.cinematic-shell .p3-form-card {
  border-top: 2px solid var(--cine-gold) !important;
}

.cinematic-shell .p3-form label {
  color: var(--cine-ivory-soft);
  letter-spacing: 0.025em;
}

.cinematic-shell .p3-form label .text-red-500 {
  color: #E6A995 !important;
}

.cinematic-shell .p3-form .p3-input {
  background: rgba(255, 255, 255, 0.035) !important;
  border: 1px solid var(--cine-gold-line) !important;
  color: var(--cine-ivory) !important;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.24);
  transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.cinematic-shell .p3-form .p3-input::placeholder {
  color: var(--cine-ivory-muted);
  opacity: 1;
}

.cinematic-shell .p3-form .p3-input:hover {
  border-color: rgba(201, 167, 97, 0.45) !important;
}

.cinematic-shell .p3-form .p3-input:focus {
  background: rgba(255, 255, 255, 0.07) !important;
  border-color: var(--cine-gold-bright) !important;
  box-shadow: 0 0 0 3px rgba(201, 167, 97, 0.16) !important;
}

.cinematic-shell .p3-form select.p3-input option {
  background: #141511;
  color: var(--cine-ivory);
}

.cinematic-shell .p3-form textarea.p3-input {
  resize: vertical;
}

.cinematic-shell .p3-checkbox {
  accent-color: var(--cine-gold);
  border-color: var(--cine-gold-line) !important;
  background: rgba(255, 255, 255, 0.06) !important;
}

.cinematic-shell .p3-checkbox:focus-visible {
  outline: 2px solid var(--cine-gold-bright);
  outline-offset: 2px;
}

.cinematic-shell .p3-form-callout {
  background: rgba(201, 167, 97, 0.07) !important;
  border-left: 2px solid var(--cine-gold) !important;
  color: var(--cine-ivory-soft) !important;
}

.cinematic-shell .p3-form-error {
  background: rgba(139, 54, 45, 0.2) !important;
  border-color: rgba(224, 151, 127, 0.45) !important;
  color: #F1C9B9 !important;
}

.cinematic-shell .p3-form-success {
  background: rgba(69, 82, 64, 0.26) !important;
  border-color: rgba(201, 167, 97, 0.42) !important;
  color: #DDE9D3 !important;
}

.cinematic-shell .p3-segmented-button {
  border-radius: 0.75rem;
}

/* ── Notification popover ────────────────────────────────────────────────── */

.cinematic-shell .p3-popover-surface {
  background: linear-gradient(150deg, rgba(20, 21, 17, 0.98), rgba(10, 11, 9, 0.98)) !important;
  border-color: var(--cine-gold-line) !important;
  box-shadow: 0 28px 80px -24px rgba(0, 0, 0, 0.92);
}

.cinematic-shell .p3-popover-header {
  background: rgba(8, 9, 7, 0.58) !important;
  border-bottom-color: var(--cine-gold-line) !important;
}

.cinematic-shell .p3-popover-body {
  background: rgba(10, 11, 9, 0.5) !important;
}

.cinematic-shell .p3-notification-item {
  background: rgba(255, 255, 255, 0.045) !important;
  border-color: var(--cine-gold-line) !important;
  color: var(--cine-ivory-soft) !important;
}

.cinematic-shell .p3-notification-item:hover {
  background: rgba(201, 167, 97, 0.09) !important;
  border-color: var(--cine-gold) !important;
}

/* ── Gallery lightbox ────────────────────────────────────────────────────── */

.cinematic-shell .p3-lightbox-frame img {
  border: 1px solid var(--cine-gold-line);
  box-shadow: 0 30px 90px -24px rgba(0, 0, 0, 0.95);
}

.cinematic-shell .p3-lightbox-counter {
  background: rgba(10, 11, 9, 0.86) !important;
  border: 1px solid var(--cine-gold-line) !important;
  color: var(--cine-gold-bright) !important;
  letter-spacing: 0.08em;
}

.cinematic-shell .p3-lightbox-caption {
  color: var(--cine-gold-bright) !important;
}

/* ── Full announcement dialog (styled without editing the P0 page) ──────── */

.cinematic-shell [aria-labelledby='full-announcement-title'] {
  background:
    radial-gradient(ellipse 80% 30% at 50% 0%, rgba(201, 167, 97, 0.1), transparent 62%),
    linear-gradient(155deg, rgba(22, 23, 19, 0.98), rgba(10, 11, 9, 0.98)) !important;
  border-color: var(--cine-gold-line) !important;
  color: var(--cine-ivory);
  box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.96);
}

.cinematic-shell [aria-label='Close announcement'] {
  background: rgba(255, 255, 255, 0.05);
  border-color: var(--cine-gold-line);
  color: var(--cine-ivory-soft);
}

.cinematic-shell [aria-label='Close announcement']:hover {
  background: rgba(201, 167, 97, 0.14);
  color: var(--cine-gold-bright);
}

/* ── Recovery form: refined but intentionally practical and light ───────── */

.p3-recovery-card {
  border-top: 2px solid #B88B4A;
}

.p3-recovery-form .p3-input {
  background: #FBF9F4 !important;
  border-color: #D8CDB8 !important;
  color: #1C1B1A !important;
}

.p3-recovery-form .p3-input::placeholder {
  color: #6E675C;
  opacity: 1;
}

.p3-recovery-form .p3-input:focus {
  border-color: #A67C2F !important;
  box-shadow: 0 0 0 3px rgba(166, 124, 47, 0.15) !important;
}

.p3-recovery-form .p3-form-submit {
  background: linear-gradient(135deg, #D9B86F, #B88B4A) !important;
  color: #1C1B1A !important;
  border-color: rgba(255, 255, 255, 0.35);
}

.p3-recovery-form .p3-form-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  box-shadow: none;
}

.p3-recovery-form .p3-form-error {
  background: #FDF1EC !important;
  border-color: #E3B6A7 !important;
  color: #7A2F22 !important;
}

.p3-recovery-form .p3-form-success {
  background: #EEF3E9 !important;
  border-color: #B9CBAE !important;
  color: #314A2B !important;
}

.p3-recovery-form .p3-form-warning {
  background: #FBF3DF !important;
  border-color: #DCC58C !important;
  color: #6B4B12 !important;
}

.p3-recovery-form .p3-icon-button {
  color: #595550;
  border: 1px solid transparent;
}

.p3-recovery-form .p3-icon-button:hover {
  background: rgba(184, 139, 74, 0.12);
  border-color: rgba(184, 139, 74, 0.35);
  color: #6B4B12;
}

/* ── Footer: literary colophon ───────────────────────────────────────────── */

.cinematic-shell .p3-footer {
  background:
    radial-gradient(ellipse 70% 60% at 8% 0%, rgba(201, 167, 97, 0.1), transparent 58%),
    radial-gradient(ellipse 60% 55% at 92% 100%, rgba(164, 103, 81, 0.11), transparent 60%),
    linear-gradient(180deg, #0B0C0A 0%, #12130F 58%, #070806 100%) !important;
  border-top-color: var(--cine-gold-line) !important;
  color: var(--cine-ivory-soft);
}

.cinematic-shell .p3-footer::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(201, 167, 97, 0.6), transparent);
  pointer-events: none;
}

.cinematic-shell .p3-footer-mark {
  border-color: var(--cine-gold-line) !important;
  box-shadow: 0 0 0 4px rgba(201, 167, 97, 0.06);
}

.cinematic-shell .p3-footer-brand span:first-child {
  letter-spacing: -0.035em;
}

.cinematic-shell .p3-footer-brand span:last-child {
  letter-spacing: 0.22em;
}

.cinematic-shell .p3-footer-tagline {
  position: relative;
  padding-left: 1rem;
  border-left: 1px solid var(--cine-gold);
  color: var(--cine-ivory) !important;
}

.cinematic-shell .p3-footer-mission {
  max-width: 34rem;
  color: var(--cine-ivory-soft) !important;
}

.cinematic-shell .p3-footer-social,
.cinematic-shell .p3-footer-location {
  background: rgba(255, 255, 255, 0.045) !important;
  border-color: var(--cine-gold-line) !important;
}

.cinematic-shell .p3-footer-social {
  color: var(--cine-ivory) !important;
}

.cinematic-shell .p3-footer-social:hover {
  background: rgba(201, 167, 97, 0.12) !important;
  border-color: var(--cine-gold) !important;
}

.cinematic-shell .p3-footer-location {
  color: var(--cine-ivory-soft) !important;
}

.cinematic-shell .p3-footer-heading {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.7rem !important;
  color: var(--cine-gold-bright) !important;
  letter-spacing: 0.18em;
}

.cinematic-shell .p3-footer-heading::after {
  content: '';
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, var(--cine-gold-line), transparent);
}

.cinematic-shell .p3-footer-nav {
  color: var(--cine-ivory-soft) !important;
}

.cinematic-shell .p3-footer-nav li {
  position: relative;
  padding-left: 0.9rem;
}

.cinematic-shell .p3-footer-nav li::before {
  content: '';
  position: absolute;
  top: 0.65em;
  left: 0;
  width: 0.35rem;
  height: 1px;
  background: var(--cine-gold);
  opacity: 0.7;
}

.cinematic-shell .p3-footer-nav button,
.cinematic-shell .p3-footer-admin {
  transition: color 0.2s ease, transform 0.2s ease;
}

.cinematic-shell .p3-footer-nav button:hover {
  color: var(--cine-gold-bright) !important;
  transform: translateX(2px);
}

.cinematic-shell .p3-footer-creed > li > span:first-child {
  color: var(--cine-gold-bright) !important;
}

.cinematic-shell .p3-footer-admin {
  color: var(--cine-gold-bright) !important;
}

.cinematic-shell .p3-footer-bottom {
  margin-top: 1.5rem;
  border-top: 1px solid var(--cine-gold-line);
  color: var(--cine-ivory-muted) !important;
}

.cinematic-shell .p3-footer-bottom span:last-child {
  color: var(--cine-ivory) !important;
}

@media (max-width: 640px) {
  .cinematic-shell .p3-footer {
    padding-top: 2.5rem;
  }

  .cinematic-shell .p3-footer-heading::after {
    max-width: 4rem;
  }

  .cinematic-shell .p3-lightbox-frame {
    padding-right: 3.25rem;
    padding-left: 3.25rem;
  }
}

/* ── P4 — scoped accessibility targets ────────────────────────────────────── */

/* Nastaliq Urdu needs more vertical room than the shared editorial leading. */
.cinematic-shell .p4-urdu-card-heading {
  line-height: 2.3;
}

@media (max-width: 1023px), (pointer: coarse) {
  .cinematic-shell .p3-footer-nav button,
  .cinematic-shell .p3-footer-admin,
  .cinematic-shell .p3-footer-social,
  .cinematic-shell .p3-footer-whatsapp,
  .cinematic-shell .p4-touch-target,
  .cinematic-shell .p2-category-bar button,
  .cinematic-shell .p2-language-bar button,
  .cinematic-shell .p3-modal-close,
  .cinematic-shell .p3-icon-button,
  .cinematic-shell .p3-modal-actions button,
  .cinematic-shell .p3-modal-actions a,
  .cinematic-shell header button[aria-label='Select language'],
  .cinematic-shell header button[aria-label='Toggle navigation menu'],
  .cinematic-shell header button[aria-label^='Sign in for notifications'],
  .cinematic-shell header button[aria-label='Open notifications'],
  .cinematic-shell header .grid.grid-cols-4 button {
    min-width: 44px;
    min-height: 44px;
  }

  .cinematic-shell .p3-footer-nav button,
  .cinematic-shell .p3-footer-admin,
  .cinematic-shell .p4-touch-target,
  .cinematic-shell .p2-category-bar button,
  .cinematic-shell .p2-language-bar button {
    display: inline-flex;
    align-items: center;
  }

  .cinematic-shell header .grid.grid-cols-4 button {
    justify-content: center;
  }

  .p3-recovery-form .p3-icon-button {
    min-width: 44px;
    min-height: 44px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cinematic-shell .p3-icon-button,
  .cinematic-shell .p3-primary-action,
  .cinematic-shell .p3-secondary-action,
  .cinematic-shell .p3-text-action,
  .cinematic-shell .p3-form-submit,
  .cinematic-shell .p3-footer-nav button,
  .cinematic-shell .p3-footer-admin {
    transition: none !important;
    transform: none !important;
  }
}
